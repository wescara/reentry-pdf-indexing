# ======================================
# Microsoft Graph API (Azure App Registration)
# ======================================
# These are shared between OneDrive and SharePoint clients
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# ======================================
# SharePoint Configuration (NEW)
# ======================================
SHAREPOINT_SITE_URL=https://wescaradatasolutions.sharepoint.com/sites/OxbowReentryDocuments
SHAREPOINT_SITE_NAME=OxbowReentryDocuments
SHAREPOINT_DRIVE_NAME=Oxbow Reentry Documents

# Switch between OneDrive and SharePoint
# Set to true to use SharePoint, false to use OneDrive
USE_SHAREPOINT=true

# ======================================
# PDF Processing Options
# ======================================
TARGET_FOLDER_PATH=Oxbow Reentry
TARGET_FOLDER_NAME=Oxbow Reentry
DOWNLOAD_DIR=downloads
SAVE_CSV=true
EXTRACT_TEXT=false

# ======================================
# Knack API Credentials
# ======================================
# Get these from your Knack app: Settings > API & Webhooks
KNACK_API_KEY=your_knack_api_key_here
KNACK_APP_ID=your_knack_app_id_here

# ======================================
# OneDrive Configuration (DEPRECATED - for reference only)
# ======================================
# If you still need OneDrive access, keep this:
# USER_UPN=kelly@wescara.com
